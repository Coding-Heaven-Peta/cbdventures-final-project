# Copy this file to .env and enter the same values used by your SQLPro connection.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbdventures_db
DB_USER=your_read_only_mysql_user
DB_PASSWORD=

# Confirmed SQL audit reference point for the Richfield Pretoria campus.
MAP_CENTER_LAT=-25.746400
MAP_CENTER_LON=28.192483
MAP_RADIUS_METRES=1000
MAP_STATUSES=APPROVED

# Set this to the frontend origin in a shared deployment. Keep * for local demo only.
CORS_ORIGIN=*
